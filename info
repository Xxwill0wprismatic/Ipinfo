#!/bin/bash

TOR_SERVICE="tor"

if systemctl list-unit-files | grep -q "^tor@default.service"; then
    TOR_SERVICE="tor@default"
elif systemctl list-unit-files | grep -q "^tor.service"; then
    TOR_SERVICE="tor"
fi

check_sudo() {
    if [ "$EUID" -ne 0 ]; then
        echo "Run as root or with sudo."
        exit 1
    fi
}

exits() {
    systemctl stop "$TOR_SERVICE"
    exit 0
}

check_dependencies() {
    dependencies=(tor torsocks curl jq)

    for dep in "${dependencies[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            echo "Installing $dep..."

            if command -v apt &>/dev/null; then
                apt update && apt install -y "$dep"
            elif command -v dnf &>/dev/null; then
                dnf install -y "$dep"
            elif command -v yum &>/dev/null; then
                yum install -y "$dep"
            elif command -v pacman &>/dev/null; then
                pacman -S --noconfirm "$dep"
            else
                echo "Unsupported package manager."
                exit 1
            fi

            command -v "$dep" &>/dev/null || exit 1
        fi
    done

    if ! systemctl is-active --quiet "$TOR_SERVICE"; then
        systemctl start "$TOR_SERVICE" || exit 1
    fi
}

change_tor_ip() {
    systemctl reload "$TOR_SERVICE" || return 1
    sleep 2
}

tor_request() {
    torsocks curl -fsS --max-time 20 "$1"
}

direct_request() {
    curl -fsS --max-time 20 "$1"
}

banner() {
    clear
    echo "IPInfo"
    echo "Developer: rabix$"
    echo
}

menu() {
    echo "[01] My Original IP"
    echo "[02] My Tor IP"
    echo "[03] Track an IP"
    echo "[04] Metadata Inspector"
    echo "[00] Exit"
    echo

    read -rp "Select an option: " option

    case "$option" in
        1|01) my_original_ip ;;
        2|02) my_tor_ip ;;
        3|03) track_ip ;;
        4|04) metadata_inspector ;;
        0|00) exits ;;
        *)
            echo "Invalid option."
            sleep 1
            menu
            ;;
    esac
}

my_original_ip() {
    local ip_data

    ip_data=$(direct_request "https://ipapi.co/json/") || {
        echo "Request failed."
        read -rp "Press Enter to continue..."
        menu
        return
    }

    parse_ip_data "$ip_data" "Your Original IP"
}

my_tor_ip() {
    change_tor_ip || {
        echo "Tor reload failed."
        read -rp "Press Enter to continue..."
        menu
        return
    }

    local ip_data
    ip_data=$(tor_request "https://ipapi.co/json/") || {
        echo "Request failed."
        read -rp "Press Enter to continue..."
        menu
        return
    }

    parse_ip_data "$ip_data" "Your Tor IP"
}

track_ip() {
    local user_ip
    local ip_data

    read -rp "Enter an IP address: " user_ip

    if [[ ! "$user_ip" =~ ^[0-9a-fA-F:.]+$ ]]; then
        echo "Invalid IP address."
        read -rp "Press Enter to continue..."
        menu
        return
    fi

    change_tor_ip || return

    ip_data=$(tor_request "https://ipapi.co/${user_ip}/json/") || {
        echo "Request failed."
        read -rp "Press Enter to continue..."
        menu
        return
    }

    parse_ip_data "$ip_data" "IP Lookup Results"
}

metadata_inspector() {
    local user_ip
    local ip_data

    read -rp "Enter an IP address (leave empty for your IP): " user_ip

    if [[ -n "$user_ip" && ! "$user_ip" =~ ^[0-9a-fA-F:.]+$ ]]; then
        echo "Invalid IP address."
        read -rp "Press Enter to continue..."
        menu
        return
    fi

    if [[ -n "$user_ip" ]]; then
        ip_data=$(direct_request "https://ipapi.co/${user_ip}/json/")
    else
        ip_data=$(direct_request "https://ipapi.co/json/")
    fi

    if [ $? -ne 0 ] || [ -z "$ip_data" ]; then
        echo "Request failed."
        read -rp "Press Enter to continue..."
        menu
        return
    fi

    if ! echo "$ip_data" | jq -e 'type == "object" and (.error != true)' >/dev/null; then
        echo "Invalid IP or unavailable metadata."
        read -rp "Press Enter to continue..."
        menu
        return
    fi

    clear
    echo "IPInfo - Metadata Inspector"
    echo "Developer: rabix$"
    echo
    echo "$ip_data" | jq .

    echo
    read -rp "Press Enter to return to the main menu..."
    menu
}

parse_ip_data() {
    local ip_data="$1"
    local title="$2"

    if ! echo "$ip_data" | jq -e 'type == "object" and (.error != true)' >/dev/null; then
        echo "Invalid IP or unavailable information."
        read -rp "Press Enter to continue..."
        menu
        return
    fi

    local_ip=$(echo "$ip_data" | jq -r '.ip // "N/A"')
    city=$(echo "$ip_data" | jq -r '.city // "N/A"')
    region=$(echo "$ip_data" | jq -r '.region // "N/A"')
    country=$(echo "$ip_data" | jq -r '.country_name // "N/A"')
    country_code=$(echo "$ip_data" | jq -r '.country // "N/A"')
    region_code=$(echo "$ip_data" | jq -r '.region_code // "N/A"')
    languages=$(echo "$ip_data" | jq -r '.languages // "N/A"')
    calling_code=$(echo "$ip_data" | jq -r '.country_calling_code // "N/A"')
    timezone=$(echo "$ip_data" | jq -r '.timezone // "N/A"')
    postal=$(echo "$ip_data" | jq -r '.postal // "N/A"')
    asn=$(echo "$ip_data" | jq -r '.asn // "N/A"')
    isp=$(echo "$ip_data" | jq -r '.org // "N/A"')
    lat=$(echo "$ip_data" | jq -r '.latitude // "N/A"')
    lon=$(echo "$ip_data" | jq -r '.longitude // "N/A"')
    currency=$(echo "$ip_data" | jq -r '.currency // "N/A"')

    echo
    echo "$title"
    echo "IP Address   : $local_ip"
    echo "City         : $city"
    echo "Region       : $region"
    echo "Country      : $country"
    echo "Country Code : $country_code"
    echo "Region Code  : $region_code"
    echo "Languages    : $languages"
    echo "Calling Code : $calling_code"
    echo "Timezone     : $timezone"
    echo "Postal Code  : $postal"
    echo "ASN          : $asn"
    echo "ISP          : $isp"
    echo "Latitude     : $lat"
    echo "Longitude    : $lon"
    echo "Coordinates  : $lat, $lon"
    echo "Currency     : $currency"
    echo "Google Maps  : https://maps.google.com/?q=$lat,$lon"

    echo
    echo "[01] View complete metadata"
    echo "[00] Return to menu"

    read -rp "Select an option: " choice

    case "$choice" in
        1|01)
            echo
            echo "$ip_data" | jq .
            read -rp "Press Enter to continue..."
            menu
            ;;
        *)
            menu
            ;;
    esac
}

check_sudo
check_dependencies
banner
menu
